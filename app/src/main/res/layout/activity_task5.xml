<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center_vertical|end"
        android:text="0"
        android:textSize="36sp" />

    <TableLayout
        android:id="@+id/tableKeys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">

        <TableRow>
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="7" />
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="8" />
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="9" />
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="/" />
        </TableRow>

        <TableRow>
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="4" />
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="5" />
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="6" />
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="*" />
        </TableRow>

        <TableRow>
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="1" />
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="2" />
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="3" />
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="-" />
        </TableRow>

        <TableRow>
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="C" />
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="0" />
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="=" />
            <Button android:layout_width="wrap_content" android:layout_height="72dp" android:onClick="onKeyClick" android:text="+" />
        </TableRow>
    </TableLayout>
</LinearLayout>
